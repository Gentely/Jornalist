# Supabase (Auth, DB, Storage) — create a project at https://supabase.com
# The site runs in demo/mock mode when these are empty.
# Current Supabase dashboards: use the Publishable key shown in Connect
# or Settings > API Keys. It normally starts with sb_publishable_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Legacy projects only: if your dashboard gives you an "anon" key instead,
# you may remove the publishable line above and use this variable name.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Required on the server for real orders, private receipts, admin checks and
# signed downloads. In Vercel add it as a server Environment Variable.
# Do NOT prefix this secret with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SECRET_KEY=sb_secret_your-key
# Legacy projects may use this instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=218918199601
NEXT_PUBLIC_CONTACT_EMAIL=mohamed.bahur@gmail.com
